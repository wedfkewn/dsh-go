@@ -0,0 +1,38 @@
+#ifndef UTIL_GUEST_THREADS_H
+#define UTIL_GUEST_THREADS_H
+#include <stdbool.h>
+#include <pthread.h>
+/* This registry owns completion records, never task/timer storage. */
+int guest_thread_create(pthread_t *thread, void *(*run)(void *), void *arg, void *owner);
+/* Retire task storage; reclaimed only after its host thread has been joined. */
+void guest_thread_retire(void *owner);
+int guest_threads_reap(void);
+/* Stops admission. Does not by itself interrupt host syscalls. */
+void guest_threads_request_stop(void);
+bool guest_threads_stopping(void);
+/* Supervisor only, outside kernel locks; EBUSY if workers are still running. */
+int guest_threads_join_stopped(void);
+struct guest_service;
+/* Host errno APIs. Supervisor owns the handle until destroy succeeds.
+ * No external concurrent handle use is permitted across destroy. */
+int guest_service_new(struct guest_service **out);
+/* Explicit service entry is supervisor-only; worker children use inherited
+ * guest_thread_create. Do not move a live worker between services. */
+int guest_service_thread_create(struct guest_service *, pthread_t *,
+        void *(*run)(void *), void *arg, void *owner);
+bool guest_service_stopping(struct guest_service *);
+/* Borrowed fd, poll only: never read, close, or change flags. */
+int guest_service_wake_fd(struct guest_service *);
+/* Returns host errno if wake write fails; stop remains set, call may retry. */
+int guest_service_request_stop(struct guest_service *);
+/* EINVAL before stop; EBUSY while any member has not been joined.
+ * Does not join init or other services, or imply kernel resource reaping. */
+int guest_service_join_stopped(struct guest_service *);
+int guest_service_destroy(struct guest_service *);
+/* Does NOT reset kernel globals or authorize another boot. */
+#endif
+/* Entry workers bind their constructed task before guest execution. */
+void guest_thread_bind_owner(void *owner);
+/* Call with pids_lock held; lock order is pids_lock -> registry_lock. */
+bool guest_service_has_owner(struct guest_service *, void *owner);
+bool guest_current_service_stopping(void);

