+++ b/util/guest_threads.c
@@ -0,0 +1,208 @@
+#include "util/guest_threads.h"
+#include <errno.h>
+#include <stdatomic.h>
+#include <stdlib.h>
+#include <unistd.h>
+#include <fcntl.h>
+
+struct guest_service {
+    atomic_bool stopping;
+    int wake[2];
+    bool wake_sent; /* registry_lock; set by successful stop write, never cleared */
+    size_t outstanding; /* registry_lock; decremented only after join */
+};
+static _Thread_local struct guest_service *current_service;
+
+struct worker {
+    pthread_t thread;
+    void *(*run)(void *);
+    void *arg, *owner;
+    bool done, retired;
+    struct guest_service *service;
+    struct worker *next;
+};
+static pthread_mutex_t registry_lock = PTHREAD_MUTEX_INITIALIZER;
+static struct worker *workers;
+static atomic_bool stopping;
+
+bool guest_threads_stopping(void) {
+    return atomic_load_explicit(&stopping, memory_order_acquire);
+}
+void guest_threads_request_stop(void) {
+    pthread_mutex_lock(&registry_lock);
+    atomic_store_explicit(&stopping, true, memory_order_release);
+    pthread_mutex_unlock(&registry_lock);
+}
+static void completed(void *arg) {
+    struct worker *worker = arg;
+    pthread_mutex_lock(&registry_lock);
+    worker->done = true;
+    pthread_mutex_unlock(&registry_lock);
+}
+static void *run_worker(void *arg) {
+    struct worker *worker = arg;
+    void *result;
+    current_service = worker->service;
+    pthread_cleanup_push(completed, worker);
+    result = worker->run(worker->arg);
+    pthread_cleanup_pop(1);
+    return result;
+}
+int guest_service_thread_create(struct guest_service *service, pthread_t *thread,
+        void *(*run)(void *), void *arg, void *owner) {
+    struct worker *worker = calloc(1, sizeof(*worker));
+    if (!worker) return ENOMEM;
+    worker->run = run;
+    worker->arg = arg;
+    worker->owner = owner;
+    worker->service = service;
+    pthread_mutex_lock(&registry_lock);
+    int err = (guest_threads_stopping() || guest_service_stopping(service)) ? ECANCELED :
+        pthread_create(&worker->thread, NULL, run_worker, worker);
+    if (!err) {
+        if (service) service->outstanding++;
+        *thread = worker->thread;
+        worker->next = workers;
+        workers = worker;
+    }
+    pthread_mutex_unlock(&registry_lock);
+    if (err) free(worker);
+    return err;
+}
+int guest_thread_create(pthread_t *thread, void *(*run)(void *), void *arg, void *owner) {
+    return guest_service_thread_create(current_service, thread, run, arg, owner);
+}
+void guest_thread_retire(void *owner) {
+    pthread_mutex_lock(&registry_lock);
+    for (struct worker *worker = workers; worker; worker = worker->next) {
+        if (worker->owner == owner) {
+            worker->retired = true;
+            pthread_mutex_unlock(&registry_lock);
+            return;
+        }
+    }
+    pthread_mutex_unlock(&registry_lock);
+    /* First-process construction can fail before task_start. */
+    free(owner);
+}
+/* Joining a completed worker under registry_lock is safe: completed() is the
+ * outermost cleanup handler, and has released this lock before done is seen.
+ * A worker may run reap itself; never join its own pthread. */
+static int reap_locked(bool all, struct guest_service *only) {
+    struct worker **link = &workers;
+    while (*link) {
+        struct worker *worker = *link;
+        if ((only && worker->service != only) || !worker->done || pthread_equal(worker->thread, pthread_self()) ||
+                (!all && worker->owner && !worker->retired)) {
+            link = &worker->next;
+            continue;
+        }
+        int err = pthread_join(worker->thread, NULL);
+        if (err) return err;
+        *link = worker->next;
+        if (worker->service) worker->service->outstanding--;
+        if (worker->retired) free(worker->owner);
+        /* Live zombie task storage is still owned by the PID table. */
+        free(worker);
+    }
+    return 0;
+}
+int guest_threads_reap(void) {
+    pthread_mutex_lock(&registry_lock);
+    int err = reap_locked(false, NULL);
+    pthread_mutex_unlock(&registry_lock);
+    return err;
+}
+int guest_threads_join_stopped(void) {
+    pthread_mutex_lock(&registry_lock);
+    if (!guest_threads_stopping()) {
+        pthread_mutex_unlock(&registry_lock);
+        return EINVAL;
+    }
+    int err = reap_locked(true, NULL);
+    if (!err && workers) err = EBUSY;
+    pthread_mutex_unlock(&registry_lock);
+    return err;
+}
+
+int guest_service_new(struct guest_service **out) {
+    struct guest_service *service = calloc(1, sizeof(*service));
+    if (!service) return ENOMEM;
+    atomic_init(&service->stopping, false);
+    if (pipe(service->wake) < 0) {
+        int err = errno;
+        free(service);
+        return err;
+    }
+    for (int i = 0; i < 2; i++) {
+        if (fcntl(service->wake[i], F_SETFD, FD_CLOEXEC) < 0 ||
+                fcntl(service->wake[i], F_SETFL, O_NONBLOCK) < 0) {
+            int err = errno;
+            close(service->wake[0]);
+            close(service->wake[1]);
+            free(service);
+            return err;
+        }
+    }
+    *out = service;
+    return 0;
+}
+bool guest_service_stopping(struct guest_service *service) {
+    return service && atomic_load_explicit(&service->stopping, memory_order_acquire);
+}
+int guest_service_wake_fd(struct guest_service *service) {
+    return service->wake[0];
+}
+int guest_service_request_stop(struct guest_service *service) {
+    pthread_mutex_lock(&registry_lock);
+    atomic_store_explicit(&service->stopping, true, memory_order_release);
+    int err = 0;
+    if (!service->wake_sent) {
+        /* One persistent byte broadcasts readiness; nobody reads it. Both
+         * ends stay alive through all joins. A failed write is reported and
+         * a later stop call may retry; never claim a failed wake succeeded. */
+        if (write(service->wake[1], "!", 1) == 1)
+            service->wake_sent = true;
+        else
+            err = errno;
+    }
+    pthread_mutex_unlock(&registry_lock);
+    return err;
+}
+int guest_service_join_stopped(struct guest_service *service) {
+    pthread_mutex_lock(&registry_lock);
+    int err = !guest_service_stopping(service) ? EINVAL : reap_locked(true, service);
+    if (!err && service->outstanding) err = EBUSY;
+    pthread_mutex_unlock(&registry_lock);
+    return err;
+}
+int guest_service_destroy(struct guest_service *service) {
+    /* Supervisor owns service lifetime, serializes stop/fence/destroy, and
+     * discards all external handles before destroy. Workers retain it via
+     * outstanding, including children registered before stop. */
+    int err = guest_service_join_stopped(service);
+    if (err) return err;
+    close(service->wake[0]);
+    close(service->wake[1]);
+    free(service);
+    return 0;
+}
+void guest_thread_bind_owner(void *owner) {
+    pthread_mutex_lock(&registry_lock);
+    for (struct worker *w = workers; w; w = w->next)
+        if (pthread_equal(w->thread, pthread_self())) { w->owner = owner; break; }
+    pthread_mutex_unlock(&registry_lock);
+}
+bool guest_service_has_owner(struct guest_service *service, void *owner) {
+    bool found = false;
+    pthread_mutex_lock(&registry_lock);
+    for (struct worker *w = workers; w; w = w->next)
+        if (w->service == service && w->owner == owner && !w->done && !w->retired) {
+            found = true; break;
+        }
+    pthread_mutex_unlock(&registry_lock);
+    return found;
+}
+bool guest_current_service_stopping(void) {
+    return guest_service_stopping(current_service);
+}

